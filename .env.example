# Supabase Auth (obligatorio para los paneles /admin y /cocina)
# URL del proyecto Supabase (puede compartir nombre con la usada por Vercel)
VITE_SUPABASE_URL=https://TU_PROYECTO.supabase.co
# Clave pública anon. Es segura en el cliente; NUNCA pongas aquí la service_role.
VITE_SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY
# Clave de servicio SOLO para funciones serverless de Vercel (api/_auth.ts)
SUPABASE_SERVICE_ROLE_KEY=TU_SUPABASE_SERVICE_ROLE_KEY

# Base de datos Neon (productos y pedidos)
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST/DB?sslmode=require

# Stripe
STRIPE_SECRET_KEY=sk_test_TU_CLAVE_SECRETA
STRIPE_WEBHOOK_SECRET=whsec_TU_SECRETO_DE_WEBHOOK
