{
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm -r build",
  "outputDirectory": "artifacts/cafes-de-carla/dist/public",
  "rewrites": [
    { "source": "/success", "destination": "/index.html" },
    { "source": "/cocina", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/aviso-legal", "destination": "/index.html" },
    { "source": "/politica-privacidad", "destination": "/index.html" },
    { "source": "/politica-cookies", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/acceso-denegado", "destination": "/index.html" }
  ],
  "routes": [
    { "src": "/api/create-checkout-session", "dest": "/api/create-checkout-session", "methods": ["POST"] },
    { "src": "/api/webhook", "dest": "/api/webhook", "methods": ["POST"] },
    { "src": "/api/stripe-webhook", "dest": "/api/stripe-webhook", "methods": ["POST"] },
    { "src": "/api/orders", "dest": "/api/orders", "methods": ["GET", "POST", "PATCH", "OPTIONS"] },
    { "src": "/api/orders/(.*)", "dest": "/api/orders", "methods": ["GET", "POST", "PATCH", "OPTIONS"] },
    { "src": "/api/products", "dest": "/api/products", "methods": ["GET", "POST", "PATCH", "DELETE", "OPTIONS"] },
    { "src": "/api/products/(.*)", "dest": "/api/products", "methods": ["GET", "POST", "PATCH", "DELETE", "OPTIONS"] },
    { "src": "/api/categories", "dest": "/api/categories", "methods": ["GET", "OPTIONS"] },
    { "src": "/api/upload", "dest": "/api/upload", "methods": ["POST", "OPTIONS"] }
  ]
}
